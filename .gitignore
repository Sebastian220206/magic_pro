# dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/

# environment files
#
# Deny everything env-shaped and allow templates back in by name. The repo is
# public, so a variant nobody thought to list — .env.mcp was one — is a leak
# the moment it is created. Opting in beats enumerating.
.env
.env.*
!.env.example
!.env.mcp.example

# Prisma
prisma/dev.db
prisma/dev.db-journal

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Supabase local
supabase/.branches
supabase/.temp

