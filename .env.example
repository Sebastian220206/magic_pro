# =============================================================================
# Magic Pro — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# REQUIRED variables are marked with [REQUIRED].
# OPTIONAL variables have defaults or are only needed for specific features.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE — PostgreSQL / Supabase
# ---------------------------------------------------------------------------
# [REQUIRED] Connection string for Prisma / PostgreSQL.
# Local:   postgresql://postgres:password@localhost:5432/daw_db?schema=public
# Supabase: Get from Project Settings → Database → Connection string (Transaction pooler)
DATABASE_URL="postgresql://postgres:password@localhost:5432/daw_db?schema=public"

# [REQUIRED] Direct connection to Supabase (bypasses pooler for migrations).
# Only needed for running Prisma migrations. Same as DATABASE_URL but without ?pgbouncer=true
# DIRECTOR_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# AUTHENTICATION — NextAuth
# ---------------------------------------------------------------------------
# [REQUIRED] A random 64-character hex string used to encrypt NextAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-real-64-char-hex-secret"

# [REQUIRED] The canonical URL of your app. Used for callback URLs in OAuth flows.
# Local:     http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SUPABASE — (optional, only if using Supabase beyond PostgreSQL)
# ---------------------------------------------------------------------------
# Optional. Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Optional. Service role key for admin operations. Keep secret — never expose to client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# COLLABORATION — CRDT / Yjs WebSocket
# ---------------------------------------------------------------------------
# Optional. WebSocket URL for real-time collaboration (Yjs/y-websocket).
# If not set, collaboration features will be unavailable but the app will still work.
# Local:      ws://localhost:1234
# Production: wss://your-crdt-server.example.com
# NEXT_PUBLIC_CRDT_URL="ws://localhost:1234"

# ---------------------------------------------------------------------------
# STORAGE — File uploads / sample storage (optional)
# ---------------------------------------------------------------------------
# Optional. S3-compatible bucket for user-uploaded samples and project assets.
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_BUCKET="magic-pro-assets"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"

# ---------------------------------------------------------------------------
# AI FEATURES — OpenAI (optional, needed for Phase 5 AI Assistant)
# ---------------------------------------------------------------------------
# [OPTIONAL] OpenAI API key for AI features: chord suggestion, melody generation,
# auto-mix suggestions, and lyric assistant.
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-your-openai-api-key-here"

# ---------------------------------------------------------------------------
# ANALYTICS (optional)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ---------------------------------------------------------------------------
# DEPLOYMENT — Vercel (set automatically by Vercel — no action needed)
# ---------------------------------------------------------------------------
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. Never commit .env or .env.local to version control.
# 2. On Vercel, add all variables via Project Settings → Environment Variables.
# 3. For Supabase: The connection string in DATABASE_URL should use the
#    Transaction pooler (port 6543) for serverless, and the Session pooler
#    (port 5432) for long-running connections.
# 4. NEXTAUTH_SECRET should be the same across all deployments (dev, preview, prod)
#    to maintain session validity across environments.
# 5. The app will NOT start without DATABASE_URL and NEXTAUTH_SECRET set.
# =============================================================================
