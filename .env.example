# =============================================================================
# Magic Pro — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# [REQUIRED] — the app will not run without it.
# [OPTIONAL] — a feature is disabled without it; the app still starts.
#
# Every variable listed here is actually read by the code. If you add one,
# add it here too — an undocumented variable is a deploy that works on one
# machine and not the next.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE — PostgreSQL / Supabase
# ---------------------------------------------------------------------------
# [REQUIRED] The connection the app uses at runtime.
# Local:    postgresql://postgres:password@localhost:5432/daw_db?schema=public
# Supabase: Project Settings → Database → Transaction pooler (port 6543)
#
# On Supabase always use the TRANSACTION pooler (6543) with pgbouncer=true.
# The session pooler (5432) is capped at ~15 clients and fails hard with
# "max clients reached in session mode" — not a slow request, an error.
#
# connection_limit depends on how the app runs, and backwards is a real
# outage either way:
#   serverless (Vercel)      -> connection_limit=1
#       one request per instance; more multiplies by instance count
#   one long-lived server    -> connection_limit=10
#       many concurrent requests; at 1 they queue and time out
DATABASE_URL="postgresql://postgres:password@localhost:5432/daw_db?schema=public"

# [REQUIRED on Supabase] Same database on port 5432, for migrations only.
# `prisma migrate` uses this (schema.prisma declares it as directUrl) because
# the transaction pooler cannot run DDL. Omit it and migrations break the
# moment DATABASE_URL points at 6543.
# DIRECT_URL="postgresql://postgres.[ref]:password@[region].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# AUTHENTICATION — NextAuth
# ---------------------------------------------------------------------------
# [REQUIRED] Secret used to encrypt session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every user out.
NEXTAUTH_SECRET="replace-with-a-real-64-char-hex-secret"

# [REQUIRED] The canonical URL of your app, used to build callback and share
# links. Getting this wrong in production produces share URLs pointing at
# localhost.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# GOOGLE SIGN-IN
# ---------------------------------------------------------------------------
# [OPTIONAL] Both must be set or the button is not shown at all — a Google
# button that fails with an opaque NextAuth error is worse than none.
# Email/password sign-in is unaffected either way.
#
# Google Cloud Console -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
#
# Authorised redirect URIs must list every origin you sign in from, exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.vercel.app/api/auth/callback/google
#
# The path is fixed by NextAuth. A mismatch gives Google's redirect_uri_mismatch
# error, which names no cause.
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ---------------------------------------------------------------------------
# SUPABASE — object storage for uploaded audio and admin soundfonts
# ---------------------------------------------------------------------------
# [OPTIONAL] Without these, audio upload and the admin soundfont library are
# unavailable. The bundled General MIDI bank does not need them.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# [OPTIONAL] Service-role key for admin operations (bucket creation, signed
# uploads, reading uploaded fonts server-side).
# Full read/write over every bucket, bypassing row-level security. Server only —
# never prefix it with NEXT_PUBLIC_, which would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# AI FEATURES — OpenAI
# ---------------------------------------------------------------------------
# [OPTIONAL] Powers chord suggestion, melody generation, auto-mix and lyrics.
# Without it those endpoints answer 503; the rest of the DAW is unaffected.
# These endpoints bill per call — see the rate limits in lib/rateLimit.ts.
# Get a key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-your-openai-api-key-here"

# ---------------------------------------------------------------------------
# BILLING — Stripe
# ---------------------------------------------------------------------------
# [OPTIONAL] Without STRIPE_SECRET_KEY the checkout and billing-portal routes
# answer 503 and the app runs as if everyone is on the free tier.
# STRIPE_SECRET_KEY="sk_test_..."

# Signing secret for the webhook endpoint (/api/stripe/webhook).
# From: Stripe Dashboard → Developers → Webhooks → your endpoint.
# Required for subscriptions to activate — without it every webhook is
# rejected, so payments succeed but nobody is ever upgraded.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Price ids for the paid tiers, from Stripe Dashboard → Products.
# STRIPE_PRO_PRICE_ID="price_..."
# STRIPE_STUDIO_PRICE_ID="price_..."

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
# [OPTIONAL] Collector for unexpected server errors. Unset, errors are still
# written to stdout as one line of JSON — this only adds forwarding.
# Accepts any endpoint taking a JSON POST, including a Sentry store endpoint.
# Payloads are scrubbed of credential-shaped strings before they are sent.
# ERROR_WEBHOOK_URL="https://collector.example.com/ingest"

# ---------------------------------------------------------------------------
# BUILD
# ---------------------------------------------------------------------------
# [OPTIONAL] Set to 1 to emit .next/standalone for the Docker image. The
# Dockerfile sets it itself; leave it unset for Vercel, which bundles its own
# way and gains nothing from it.
# BUILD_STANDALONE=1

# [OPTIONAL] Skip the General MIDI bank download that runs before every build.
# The resulting build has NO INSTRUMENTS — only for builds where that is
# intended (a CI job that only typechecks, for instance).
# SKIP_SOUNDFONT_FETCH=1

# ---------------------------------------------------------------------------
# SEED DATA — `npm run prisma db seed` only
# ---------------------------------------------------------------------------
# SEED_EMAIL="you@example.com"
# SEED_PASSWORD="change-me"
# SEED_NAME="Your Name"

# ---------------------------------------------------------------------------
# DEPLOYMENT — set automatically by Vercel, no action needed
# ---------------------------------------------------------------------------
# VERCEL_ENV=production          # tags error reports with the environment
# VERCEL_GIT_COMMIT_SHA=abc123   # tags error reports with the release

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit .env or .env.local.
# 2. On Vercel, add these via Project Settings → Environment Variables.
# 3. For Supabase, DATABASE_URL should use the Transaction pooler (port 6543)
#    on serverless. Prisma migrations need a direct connection (port 5432) —
#    pass it to `prisma migrate deploy` rather than storing it here.
# 4. NEXTAUTH_SECRET must match across environments or sessions break when
#    users move between them.
# 5. The app will not start without DATABASE_URL and NEXTAUTH_SECRET.
# =============================================================================
