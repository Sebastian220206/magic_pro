# MCP Server Environment Variables
#
# Copy to .env.mcp and fill in real values:
#   cp .env.mcp.example .env.mcp
#
# .env.mcp is gitignored. This template is the only one that belongs in the
# repository — which is public, so a real value committed here is a leaked
# value, immediately and permanently.

# GitHub MCP.
# A fine-grained token, scoped to the repositories it actually needs, with an
# expiry date set. Never reuse the credential your git remote authenticates
# with.
GITHUB_TOKEN=your_github_personal_access_token_here

# Supabase direct connection for the MCP postgres server.
# Direct, not the pooler: the transaction pooler cannot run DDL.
SUPABASE_DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Absolute path to this checkout, for the filesystem MCP server.
PROJECT_ROOT=C:\path\to\daw
