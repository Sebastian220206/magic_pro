generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  /// The app's connection. In production this is Supabase's transaction pooler
  /// (port 6543), which is the only one that survives serverless concurrency —
  /// the session pooler caps out around 15 clients and then fails hard with
  /// "max clients reached in session mode".
  url = env("DATABASE_URL")

  /// Migrations and introspection. The transaction pooler cannot run DDL, so
  /// these need a session or direct connection (port 5432). Without this,
  /// `prisma migrate deploy` fails once DATABASE_URL points at 6543.
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String
  name                      String?
  role                      String    @default("user")
  planTier                  String    @default("free")
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  stripeSubscriptionStatus  String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  projects                  Project[]
}

model Project {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  tempo             Int       @default(120)
  timeSignature     String    @default("4/4")
  keySignature      String    @default("C Maj")
  projectFormat     String    @default("stereo")
  surroundFormat    String    @default("5.1 (ITU 775)")
  spatialAudioMode  String    @default("Off")
  stateJson         Json?
  shareId         String?   @unique
  isPublic        Boolean   @default(false)
  shareCreatedAt  DateTime?
  lastOpenedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tracks            Track[]
  buses             Bus[]
}

model Track {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String   // audio, midi, drum, aux, bus
  volume      Float    @default(0.8)
  pan         Float    @default(0.0)
  muted       Boolean  @default(false)
  soloed      Boolean  @default(false)
  color       String   @default("#888888")
  orderIndex  Int      @default(0)
  
  clips       Clip[]
  plugins     Plugin[]
  automation  Automation[]
  sends       Send[]
}

model Clip {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  type      String   // audio, midi
  start     Float    // in beats
  duration  Float    // in beats
  name      String
  color     String
  fileUrl   String?  // for audio clips
  
  notes     Note[]
}

model Note {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  pitch     Int
  velocity  Int
  start     Float    // relative to clip start, in beats
  duration  Float    // in beats
}

model Automation {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  parameter String   // volume, pan, etc.
  points    AutomationPoint[]
}

model AutomationPoint {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  time         Float
  value        Float
}

model Plugin {
  id           String   @id @default(cuid())
  trackId      String
  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name         String
  slotIndex    Int
  settingsJson String?  // Stores plugin state
}

model Bus {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sends     Send[]
}

model Send {
  id      String   @id @default(cuid())
  trackId String
  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  busId   String
  bus     Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  level   Float    @default(0.0)
}

model Soundfont {
  id          String   @id @default(cuid())
  userId      String
  name        String
  storagePath String
  publicUrl   String
  presetCount Int      @default(0)
  presets     Json
  fileSize    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

/// A fixed rate-limit window, shared by every server instance.
///
/// Counters used to live in process memory, which on a serverless host means
/// each concurrently-warm instance enforces its own separate quota — so the
/// real limit was the configured one multiplied by however many instances the
/// platform happened to spin up. That matters because the endpoints it guards
/// bill per call to OpenAI.
model RateLimitWindow {
  /// Scope being limited, e.g. `ai:<userId>`.
  key       String   @id
  count     Int      @default(0)
  /// When the window rolls over and `count` restarts.
  resetAt   DateTime

  /// Expired rows are swept in bulk.
  @@index([resetAt])
}

model SoundFontLibraryItem {
  id           String   @id @default(cuid())
  name         String
  category     String
  fileUrl      String
  fileSizeKb   Int
  storagePath  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}
